{
    "name": "hypejunction/hypefilestore",
    "type": "elgg-plugin",
    "description": "File and image handling utilities",
    "homepage": "https://github.com/hypeJunction/hypeFilestore",
    "keywords": [
        "elgg",
        "plugin",
        "uploads",
        "files",
        "icons"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Ismayil Khayredinov",
            "email": "ismayil.khayredinov@gmail.com"
        }
    ],
    "extra": {
        "elgg-plugin": {
            "id": "hypefilestore"
        }
    },
    "require": {
        "php": ">=8.3",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-xml": "*",
        "ext-curl": "*",
        "ext-gd": "*",
        "elgg/elgg": "~7.0.0",
        "composer/installers": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "autoload": {
        "psr-4": {
            "hypeJunction\\Filestore\\": "classes/hypeJunction/Filestore/",
            "WideImage\\": "vendors/WideImage/lib/WideImage/"
        }
    },
    "version": "7.0.0"
}
